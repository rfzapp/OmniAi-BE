NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/omniai

# JWT secrets - use long, random, distinct values in production
JWT_ACCESS_SECRET=changeme-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-...

# Qwen / DashScope image generation
QWEN_API_KEY=sk-...
# Use your workspace-specific Singapore or Beijing API base URL when required.
QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1

# Used to encrypt user-provided (BYOK) provider API keys at rest
API_KEY_ENCRYPTION_SECRET=changeme-32-byte-random-secret

# Frontend origin allowed by CORS (credentials enabled)
FRONTEND_URL=http://localhost:3000
